<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FastFill.Checks</RootNamespace>
    <AssemblyName>FastFill.Checks</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FastFill.Core/FastFill.Core.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference
      Include="OpenCvSharp4.official.runtime.linux-x64.slim"
      Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference
      Include="OpenCvSharp4.runtime.win.slim"
      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference
      Include="SkiaSharp.NativeAssets.Linux.NoDependencies"
      Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="FrameLab.html" />
    <EmbeddedResource Include="LabHome.html" />
    <EmbeddedResource Include="SnapLab.html" />
  </ItemGroup>
</Project>
