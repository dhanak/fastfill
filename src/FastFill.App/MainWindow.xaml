                <StackPanel x:Name="ColorOptionsPanel">
                  <TextBlock Text="Color" Margin="4,10,4,2" />
                  <Grid x:Name="ColorPanel">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Background="#FF111827"
                            Tag="FF111827"
                            BorderThickness="2"
                            BorderBrush="#FF00A4EF"
                            AutomationProperties.Name="Black"
                            Click="ColorButton_Click"
                            Style="{StaticResource ColorButtonStyle}" />
                    <Button Grid.Column="1"
                            Background="#FFFFFFFF"
                            Tag="FFFFFFFF"
                            AutomationProperties.Name="White"
                            Click="ColorButton_Click"
                            Style="{StaticResource ColorButtonStyle}" />
                    <Button Grid.Column="2"
                            Background="#FFE11D48"
                            Tag="FFE11D48"
                            AutomationProperties.Name="Red"
                            Click="ColorButton_Click"
                            Style="{StaticResource ColorButtonStyle}" />
                    <Button Grid.Row="1"
                            Background="#FF0078D4"
                            Tag="FF0078D4"
                            AutomationProperties.Name="Blue"
                            Click="ColorButton_Click"
                            Style="{StaticResource ColorButtonStyle}" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Background="#FF16A34A"
                            Tag="FF16A34A"
                            AutomationProperties.Name="Green"
                            Click="ColorButton_Click"
                            Style="{StaticResource ColorButtonStyle}" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Background="#FFFFD800"
                            Tag="FFFFD800"
                            AutomationProperties.Name="Yellow"
                            Click="ColorButton_Click"
                            Style="{StaticResource ColorButtonStyle}" />
                  </Grid>
                </StackPanel>
                <StackPanel x:Name="ThicknessPanel">
                  <TextBlock Text="Thickness"
                             Margin="4,8,4,0" />
                  <Slider x:Name="ThicknessSlider"
                          Minimum="1"
                          Maximum="20"
                          Value="3"
                          StepFrequency="1"
                          ValueChanged="ThicknessSlider_ValueChanged" />
                </StackPanel>
                <StackPanel x:Name="FontPanel" Spacing="4">
                  <ComboBox x:Name="FontFamilyPicker"
                            Header="Typeface"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="FontFamily_SelectionChanged">
                    <ComboBoxItem Content="Segoe UI" />
                    <ComboBoxItem Content="Arial" />
                    <ComboBoxItem Content="Calibri" />
                    <ComboBoxItem Content="Times New Roman" />
                  </ComboBox>
                  <NumberBox x:Name="FontSizePicker"
                             Header="Font size"
                             Minimum="6"
                             Maximum="144"
                             Value="18"
                             SmallChange="1"
                             SpinButtonPlacementMode="Inline"
                             PreviewKeyDown="FontSizePicker_PreviewKeyDown"
                             ValueChanged="FontSize_ValueChanged" />
                  <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="BoldTextToggle"
                                  Click="TextStyleToggle_Click"
                                  AutomationProperties.Name="Bold"
                                  ToolTipService.ToolTip="Bold"
                                  Style="{StaticResource ToolToggleStyle}">
                      <TextBlock Text="B" FontWeight="Bold" />
                    </ToggleButton>
                    <ToggleButton x:Name="ItalicTextToggle"
                                  Grid.Column="1"
                                  Click="TextStyleToggle_Click"
                                  AutomationProperties.Name="Italic"
                                  ToolTipService.ToolTip="Italic"
                                  Style="{StaticResource ToolToggleStyle}">
                      <TextBlock Text="I" FontStyle="Italic" />
                    </ToggleButton>
                    <ToggleButton x:Name="UnderlineTextToggle"
                                  Grid.Column="2"
                                  Click="TextStyleToggle_Click"
                                  AutomationProperties.Name="Underline"
                                  ToolTipService.ToolTip="Underline"
                                  Style="{StaticResource ToolToggleStyle}">
                      <TextBlock Text="U"
                                 TextDecorations="Underline" />
                    </ToggleButton>
                  </Grid>
                </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <Border Grid.Row="1"
                      Padding="8"
                      BorderBrush=
                        "{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0">
                <StackPanel Spacing="4">
                <Grid x:Name="TransformPanel" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="RotateObjectButton"
                          Click="RotateObjectButton_Click"
                          Content="↻ 0°"
                          AutomationProperties.Name="Reset rotation"
                          ToolTipService.ToolTip="Reset rotation"
                          Style=
                            "{StaticResource PaneActionButtonStyle}" />
                  <Button x:Name="SmallerObjectButton"
                          Grid.Column="1"
                          Content="−"
                          Click="SmallerObjectButton_Click"
                          AutomationProperties.Name="Make selected smaller"
                          ToolTipService.ToolTip="Make selected smaller"
                          Style=
                            "{StaticResource PaneActionButtonStyle}" />
                  <Button x:Name="LargerObjectButton"
                          Grid.Column="2"
                          Content="+"
                          Click="LargerObjectButton_Click"
                          AutomationProperties.Name="Make selected larger"
                          ToolTipService.ToolTip="Make selected larger"
                          Style=
                            "{StaticResource PaneActionButtonStyle}" />
                </Grid>
                <Grid x:Name="LayerPanel"
                      ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="SendToBackButton"
                          Click="SendToBackButton_Click"
                          AutomationProperties.Name="Send selected to back"
                          ToolTipService.ToolTip="Send selected to back"
                          Style=
                            "{StaticResource PaneActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <FontIcon Glyph="&#xE74B;" FontSize="16" />
                      <TextBlock Text="To back" />
                    </StackPanel>
                  </Button>
                  <Button x:Name="BringToFrontButton"
                          Grid.Column="1"
                          Click="BringToFrontButton_Click"
                          AutomationProperties.Name=
                            "Bring selected to front"
                          ToolTipService.ToolTip=
                            "Bring selected to front"
                          Style=
                            "{StaticResource PaneActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <FontIcon Glyph="&#xE74A;" FontSize="16" />
                      <TextBlock Text="To front" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Grid x:Name="DeletePanel" ColumnSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="DeleteObjectButton"
                          Click="DeleteObjectButton_Click"
                          AutomationProperties.Name="Delete selected"
                          ToolTipService.ToolTip="Delete selected"
                          Style=
                            "{StaticResource PaneActionButtonStyle}">
                    <FontIcon Glyph="&#xE74D;" FontSize="20" />
                  </Button>
                  <Button x:Name="DeleteAllObjectsButton"
                          Grid.Column="1"
                          Click="DeleteAllObjectsButton_Click"
                          AutomationProperties.Name="Delete all"
                          ToolTipService.ToolTip="Delete all"
                          Style=
                            "{StaticResource PaneActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                      <FontIcon Glyph="&#xE74D;" FontSize="16" />
                      <FontIcon Glyph="&#xE74D;" FontSize="16" />
                    </StackPanel>
                  </Button>
                </Grid>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
