<Window
  x:Class="FastFill.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:skia="using:SkiaSharp.Views.Windows"
  Title="FastFill">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        KeyDown="RootGrid_KeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid Padding="12,6" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Image Width="42"
                 Height="42"
                 Source="Assets/AppIcon.png" />
          <TextBlock Text="FastFill"
                     FontSize="24"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="StatusText"
                   Grid.Column="1"
                   Text="Ready"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="UndoButton"
                  Content="Undo"
                  IsEnabled="False"
                  Click="UndoButton_Click"
                  Style="{StaticResource TouchButtonStyle}" />
          <Button x:Name="RedoButton"
                  Content="Redo"
                  IsEnabled="False"
                  Click="RedoButton_Click"
                  Style="{StaticResource TouchButtonStyle}" />
          <Button x:Name="SaveButton"
                  Content="Save project"
                  IsEnabled="False"
                  Click="SaveButton_Click"
                  Style="{StaticResource TouchButtonStyle}" />
          <Button x:Name="ExportButton"
                  Content="Export PDF"
                  IsEnabled="False"
                  Click="ExportButton_Click"
                  Style="{StaticResource TouchButtonStyle}" />
          <Button x:Name="ShareButton"
                  Content="Share"
                  IsEnabled="False"
                  Click="ShareButton_Click"
                  Style="{StaticResource TouchButtonStyle}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid x:Name="HomePanel">
        <StackPanel Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="Scan. Fill. Send."
                     FontSize="36"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Documents stay on this device."
                     FontSize="18"
                     HorizontalAlignment="Center" />
          <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="NewScanButton_Click"
                    Style="{StaticResource HomeTileButtonStyle}"
                    AutomationProperties.Name="New camera scan">
              <StackPanel Spacing="12">
                <FontIcon Glyph="&#xE114;" FontSize="38" />
                <TextBlock Text="New camera scan"
                           FontSize="18"
                           TextAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1"
                    Click="ImportButton_Click"
                    Style="{StaticResource HomeTileButtonStyle}"
                    AutomationProperties.Name="Import JPEG or PNG">
              <StackPanel Spacing="12">
                <FontIcon Glyph="&#xE91B;" FontSize="38" />
                <TextBlock Text="Import image"
                           FontSize="18"
                           TextAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Row="1"
                    Click="OpenButton_Click"
                    Style="{StaticResource HomeTileButtonStyle}"
                    AutomationProperties.Name="Open FastFill project">
              <StackPanel Spacing="12">
                <FontIcon Glyph="&#xE8E5;" FontSize="38" />
                <TextBlock Text="Open project"
                           FontSize="18"
                           TextAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="RecoverButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Click="RecoverButton_Click"
                    Style="{StaticResource HomeTileButtonStyle}"
                    AutomationProperties.Name="Recover autosaved project">
              <StackPanel Spacing="12">
                <FontIcon Glyph="&#xE777;" FontSize="38" />
                <TextBlock Text="Recover autosave"
                           FontSize="18"
                           TextAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Grid>

      <Grid x:Name="ReviewPanel"
            Visibility="Collapsed"
            Padding="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#FF202020" CornerRadius="8">
          <skia:SKXamlCanvas x:Name="ReviewCanvas"
                             IgnorePixelScaling="True"
                             PaintSurface="ReviewCanvas_PaintSurface"
                             PointerPressed="ReviewCanvas_PointerPressed"
                             PointerMoved="ReviewCanvas_PointerMoved"
                             PointerReleased="ReviewCanvas_PointerReleased" />
        </Border>
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Padding="0,10,0,0"
                      Spacing="8">
            <Button Content="Retake"
                    Click="RetakeButton_Click"
                    Style="{StaticResource TouchButtonStyle}" />
            <ToggleButton x:Name="AdjustCornersToggle"
                          Content="Adjust corners"
                          IsChecked="True"
                          Checked="ReviewSetting_Changed"
                          Unchecked="ReviewSetting_Changed"
                          Style="{StaticResource ToolToggleStyle}" />
            <ComboBox x:Name="FilterPicker"
                      Header="Color"
                      MinWidth="170"
                      SelectedIndex="0"
                      SelectionChanged="FilterPicker_SelectionChanged">
              <ComboBoxItem Content="Original" />
              <ComboBoxItem Content="Enhanced color" />
              <ComboBoxItem Content="Grayscale" />
              <ComboBoxItem Content="Black and white" />
            </ComboBox>
            <StackPanel Width="180">
              <TextBlock Text="Contrast" />
              <Slider x:Name="ContrastSlider"
                      Minimum="-100"
                      Maximum="100"
                      Value="0"
                      StepFrequency="5"
                      ValueChanged="ContrastSlider_ValueChanged" />
            </StackPanel>
            <Button Content="Rotate"
                    Click="RotatePageButton_Click"
                    Style="{StaticResource TouchButtonStyle}" />
            <Button Content="Accept page"
                    Click="AcceptPageButton_Click"
                    Style="{StaticResource TouchButtonStyle}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="EditorPanel" Visibility="Collapsed">
        <Grid x:Name="EditorLayout" Padding="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PageColumn" Width="136" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ToolColumn" Width="216" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="PageStripRow" Height="0" />
            <RowDefinition x:Name="ToolStripRow" Height="0" />
          </Grid.RowDefinitions>
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
              <VisualState x:Name="WideEditor">
                <VisualState.StateTriggers>
                  <AdaptiveTrigger MinWindowWidth="900" />
                </VisualState.StateTriggers>
              </VisualState>
              <VisualState x:Name="NarrowEditor">
                <VisualState.StateTriggers>
                  <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                  <Setter Target="PageRail.(Grid.Row)" Value="1" />
                  <Setter Target="PageRail.(Grid.Column)" Value="0" />
                  <Setter Target="PageRail.(Grid.ColumnSpan)" Value="3" />
                  <Setter Target="ToolRail.(Grid.Row)" Value="2" />
                  <Setter Target="ToolRail.(Grid.Column)" Value="0" />
                  <Setter Target="ToolRail.(Grid.ColumnSpan)" Value="3" />
                  <Setter Target="EditorHost.(Grid.Column)" Value="0" />
                  <Setter Target="EditorHost.(Grid.ColumnSpan)" Value="3" />
                  <Setter Target="PageStripRow.Height" Value="108" />
                  <Setter Target="ToolStripRow.Height" Value="Auto" />
                  <Setter Target="PageColumn.Width" Value="0" />
                  <Setter Target="ToolColumn.Width" Value="0" />
                  <Setter Target="ToolPanel.Orientation"
                          Value="Horizontal" />
                  <Setter
                    Target="ToolScrollViewer.HorizontalScrollBarVisibility"
                    Value="Auto" />
                  <Setter
                    Target="ToolScrollViewer.VerticalScrollBarVisibility"
                    Value="Disabled" />
                </VisualState.Setters>
              </VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>

          <Border x:Name="PageRail"
                  Grid.Column="0"
                  Margin="0,0,8,0"
                  Background=
                    "{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock Text="Pages"
                         FontWeight="SemiBold"
                         Margin="10" />
              <ListView x:Name="PageList"
                        Height="360"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        ReorderMode="Enabled"
                        DragItemsStarting="PageList_DragItemsStarting"
                        DragItemsCompleted="PageList_DragItemsCompleted"
                        SelectionChanged="PageList_SelectionChanged" />
              <Grid ColumnSpacing="2" Margin="2,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="↑"
                        AutomationProperties.Name="Move page earlier"
                        Click="MovePageEarlierButton_Click"
                        Style="{StaticResource RailButtonStyle}" />
                <Button Grid.Column="1"
                        Content="↓"
                        AutomationProperties.Name="Move page later"
                        Click="MovePageLaterButton_Click"
                        Style="{StaticResource RailButtonStyle}" />
              </Grid>
              <Button Content="Add page"
                      Click="AddPageButton_Click"
                      Style="{StaticResource RailButtonStyle}" />
              <Button Content="Import"
                      Click="ImportButton_Click"
                      Style="{StaticResource RailButtonStyle}" />
              <Button Content="Edit page"
                      Click="EditPageButton_Click"
                      Style="{StaticResource RailButtonStyle}" />
              <Button Content="Delete page"
                      Click="DeletePageButton_Click"
                      Style="{StaticResource RailButtonStyle}" />
            </StackPanel>
          </Border>

          <Border x:Name="EditorHost"
                  Grid.Column="1"
                  Background="#FF202020"
                  CornerRadius="8">
            <Grid>
              <skia:SKXamlCanvas x:Name="EditorCanvas"
                                 IgnorePixelScaling="True"
                                 PaintSurface="EditorCanvas_PaintSurface"
                                 PointerPressed="EditorCanvas_PointerPressed"
                                 PointerMoved="EditorCanvas_PointerMoved"
                                 PointerReleased="EditorCanvas_PointerReleased"
                                 PointerCanceled="EditorCanvas_PointerCanceled"
                                 DoubleTapped="EditorCanvas_DoubleTapped" />
              <Canvas x:Name="EditorOverlay">
                <TextBox x:Name="InlineTextEditor"
                         Visibility="Collapsed"
                         IsHitTestVisible="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         BorderThickness="2"
                         BorderBrush="#FF00A4EF"
                         Background="#DFFFFFFF"
                         Foreground="#FF111827"
                         Padding="3,0"
                         LostFocus="InlineTextEditor_LostFocus"
                         KeyDown="InlineTextEditor_KeyDown" />
              </Canvas>
              <Border x:Name="NavigationBar"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="16"
                      Padding="4"
                      CornerRadius="10"
                      Visibility="Collapsed"
                      Background=
                        "{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="−"
                          AutomationProperties.Name="Zoom out"
                          ToolTipService.ToolTip="Zoom out"
                          Click="ZoomOutButton_Click"
                          Style="{StaticResource TouchButtonStyle}" />
                  <Button Content="+"
                          AutomationProperties.Name="Zoom in"
                          ToolTipService.ToolTip="Zoom in"
                          Click="ZoomInButton_Click"
                          Style="{StaticResource TouchButtonStyle}" />
                  <Button Content="1:1"
                          AutomationProperties.Name="Actual size"
                          ToolTipService.ToolTip="Actual size"
                          Click="ActualSizeButton_Click"
                          Style="{StaticResource TouchButtonStyle}" />
                  <Button AutomationProperties.Name="Full view"
                          ToolTipService.ToolTip="Full view"
                          Click="FitButton_Click"
                          Style="{StaticResource TouchButtonStyle}">
                    <FontIcon Glyph="&#xE9A6;" />
                  </Button>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border x:Name="ToolRail"
                  Grid.Column="2"
                  Margin="8,0,0,0"
                  Background=
                    "{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8">
            <ScrollViewer x:Name="ToolScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ToolPanel" Padding="8">
                <TextBlock Text="Tools"
                           FontWeight="SemiBold"
                           Margin="4,4,4,6" />
                <Grid x:Name="ToolButtonGrid">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ToggleButton Click="ToolButton_Click"
                                Tag="Navigate"
                                ToolTipService.ToolTip="Navigate page"
                                AutomationProperties.Name="Navigate page"
                                Style="{StaticResource ToolToggleStyle}">
                    <TextBlock Text="✋"
                               FontFamily="Segoe UI Symbol"
                               FontSize="20" />
                  </ToggleButton>
                  <ToggleButton x:Name="SelectToolButton"
                                Grid.Column="1"
                                IsChecked="True"
                                Click="ToolButton_Click"
                                Tag="Select"
                                ToolTipService.ToolTip="Select and move"
                                AutomationProperties.Name="Select and move"
                                Style="{StaticResource ToolToggleStyle}">
                    <FontIcon Glyph="&#xE7C9;" FontSize="20" />
                  </ToggleButton>
                  <ToggleButton Grid.Column="2"
                                Click="ToolButton_Click"
                                Tag="Text"
                                ToolTipService.ToolTip="Text"
                                AutomationProperties.Name="Text"
                                Style="{StaticResource ToolToggleStyle}">
                    <FontIcon Glyph="&#xE8D2;" FontSize="20" />
                  </ToggleButton>
                  <ToggleButton Grid.Row="1"
                                Click="ToolButton_Click"
                                Tag="Pen"
                                ToolTipService.ToolTip="Pen"
                                AutomationProperties.Name="Pen"
                                Style="{StaticResource ToolToggleStyle}">
                    <FontIcon Glyph="&#xE76D;" FontSize="20" />
                  </ToggleButton>
                  <ToggleButton Grid.Row="1"
                                Grid.Column="1"
                                Click="ToolButton_Click"
                                Tag="Highlighter"
                                ToolTipService.ToolTip="Highlighter"
                                AutomationProperties.Name="Highlighter"
                                Style="{StaticResource ToolToggleStyle}">
                    <FontIcon Glyph="&#xE7E6;" FontSize="20" />
                  </ToggleButton>
                  <ToggleButton Grid.Row="1"
                                Grid.Column="2"
                                Click="ToolButton_Click"
                                Tag="Line"
                                ToolTipService.ToolTip="Straight line"
                                AutomationProperties.Name="Straight line"
                                Style="{StaticResource ToolToggleStyle}">
                    <TextBlock Text="╱" FontSize="24" />
                  </ToggleButton>
                  <ToggleButton Grid.Row="2"
                                Click="ToolButton_Click"
                                Tag="Arrow"
                                ToolTipService.ToolTip="Arrow"
                                AutomationProperties.Name="Arrow"
                                Style="{StaticResource ToolToggleStyle}">
                    <TextBlock Text="↗" FontSize="24" />
                  </ToggleButton>
                  <ToggleButton Grid.Row="2"
                                Grid.Column="1"
                                Click="ToolButton_Click"
                                Tag="Rectangle"
                                ToolTipService.ToolTip="Box"
                                AutomationProperties.Name="Box"
                                Style="{StaticResource ToolToggleStyle}">
                    <Rectangle Width="22"
                               Height="18"
                               StrokeThickness="2"
                               Stroke=
                                 "{ThemeResource TextFillColorPrimaryBrush}" />
                  </ToggleButton>
                  <ToggleButton Grid.Row="2"
                                Grid.Column="2"
                                Click="ToolButton_Click"
                                Tag="Ellipse"
                                ToolTipService.ToolTip="Oval"
                                AutomationProperties.Name="Oval"
                                Style="{StaticResource ToolToggleStyle}">
                    <TextBlock Text="○" FontSize="24" />
                  </ToggleButton>
                  <ToggleButton Grid.Row="3"
                                Click="ToolButton_Click"
                                Tag="Checkmark"
                                ToolTipService.ToolTip="Checkmark"
                                AutomationProperties.Name="Checkmark"
                                Style="{StaticResource ToolToggleStyle}">
                    <TextBlock Text="✓" FontSize="24" />
                  </ToggleButton>
                  <ToggleButton Grid.Row="3"
                                Grid.Column="1"
                                Click="ToolButton_Click"
                                Tag="Cross"
                                ToolTipService.ToolTip="X mark"
                                AutomationProperties.Name="X mark"
                                Style="{StaticResource ToolToggleStyle}">
                    <TextBlock Text="✕" FontSize="22" />
                  </ToggleButton>
                </Grid>
                <TextBlock Text="Color" Margin="4,10,4,2" />
                <Grid x:Name="ColorPanel">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Button Background="#FF111827"
                          Tag="FF111827"
                          BorderThickness="3"
                          BorderBrush="#FF00A4EF"
                          AutomationProperties.Name="Black"
                          Click="ColorButton_Click"
                          Style="{StaticResource ColorButtonStyle}" />
                  <Button Grid.Column="1"
                          Background="#FFFFFFFF"
                          Tag="FFFFFFFF"
                          AutomationProperties.Name="White"
                          Click="ColorButton_Click"
                          Style="{StaticResource ColorButtonStyle}" />
                  <Button Grid.Column="2"
                          Background="#FFE11D48"
                          Tag="FFE11D48"
                          AutomationProperties.Name="Red"
                          Click="ColorButton_Click"
                          Style="{StaticResource ColorButtonStyle}" />
                  <Button Grid.Row="1"
                          Background="#FF0078D4"
                          Tag="FF0078D4"
                          AutomationProperties.Name="Blue"
                          Click="ColorButton_Click"
                          Style="{StaticResource ColorButtonStyle}" />
                  <Button Grid.Row="1"
                          Grid.Column="1"
                          Background="#FF16A34A"
                          Tag="FF16A34A"
                          AutomationProperties.Name="Green"
                          Click="ColorButton_Click"
                          Style="{StaticResource ColorButtonStyle}" />
                  <Button Grid.Row="1"
                          Grid.Column="2"
                          Background="#FFFFD800"
                          Tag="FFFFD800"
                          AutomationProperties.Name="Yellow"
                          Click="ColorButton_Click"
                          Style="{StaticResource ColorButtonStyle}" />
                </Grid>
                <TextBlock x:Name="ThicknessLabel"
                           Text="Thickness"
                           Margin="4,8,4,0" />
                <Slider x:Name="ThicknessSlider"
                        Minimum="1"
                        Maximum="20"
                        Value="3"
                        StepFrequency="1"
                        ValueChanged="ThicknessSlider_ValueChanged" />
                <StackPanel x:Name="FillPanel"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="4,2">
                  <TextBlock Text="Fill" VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="FilledToggle"
                                OnContent=""
                                OffContent=""
                                Toggled="FilledToggle_Toggled" />
                </StackPanel>
                <StackPanel x:Name="FontPanel" Spacing="4">
                  <ComboBox x:Name="FontFamilyPicker"
                            Header="Typeface"
                            SelectedIndex="0"
                            SelectionChanged="FontFamily_SelectionChanged">
                    <ComboBoxItem Content="Segoe UI" />
                    <ComboBoxItem Content="Arial" />
                    <ComboBoxItem Content="Calibri" />
                    <ComboBoxItem Content="Times New Roman" />
                  </ComboBox>
                  <NumberBox x:Name="FontSizePicker"
                             Header="Font size"
                             Minimum="6"
                             Maximum="144"
                             Value="18"
                             SmallChange="1"
                             SpinButtonPlacementMode="Compact"
                             ValueChanged="FontSize_ValueChanged" />
                </StackPanel>
                <Grid x:Name="TransformPanel" Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Click="RotateObjectButton_Click"
                          Content="↻ 15°"
                          AutomationProperties.Name="Rotate selected"
                          ToolTipService.ToolTip="Rotate selected"
                          Padding="4"
                          Style="{StaticResource TouchButtonStyle}" />
                  <Button Grid.Column="1"
                          Content="−"
                          Click="SmallerObjectButton_Click"
                          AutomationProperties.Name="Make selected smaller"
                          ToolTipService.ToolTip="Make selected smaller"
                          Style="{StaticResource TouchButtonStyle}" />
                  <Button Grid.Column="2"
                          Content="+"
                          Click="LargerObjectButton_Click"
                          AutomationProperties.Name="Make selected larger"
                          ToolTipService.ToolTip="Make selected larger"
                          Style="{StaticResource TouchButtonStyle}" />
                </Grid>
                <Button x:Name="DeleteObjectButton"
                        Content="Delete selected"
                        IsEnabled="False"
                        Click="DeleteObjectButton_Click"
                        Style="{StaticResource RailButtonStyle}" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
