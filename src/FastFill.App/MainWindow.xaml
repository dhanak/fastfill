                  </ToggleButton>
                  <ToggleButton x:Name="FilledToggle"
                                Grid.Row="3"
                                Grid.Column="2"
                                Click="FilledToggle_Click"
                                AutomationProperties.Name="Fill"
                                ToolTipService.ToolTip="Fill"
                                Style="{StaticResource ToolToggleStyle}">
                    <!-- CC0 geometry adapted from SVGRepo:
                         https://www.svgrepo.com/svg/433470/fill-o -->
                    <PathIcon Width="24"
                              Height="24"
                              Data="M28,22.2 L30.613,26.12
