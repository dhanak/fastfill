#!/bin/sh

# Reject unsigned commits newly introduced to a remote.
set -u

failed=0

while read -r local_ref local_oid remote_ref remote_oid
do
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;;
    esac

    local_commit=$(git rev-parse \
        --verify "${local_oid}^{commit}" 2>/dev/null) || continue
    if remote_commit=$(git rev-parse \
        --verify "${remote_oid}^{commit}" 2>/dev/null)
    then
        commits=$(git rev-list \
            "${remote_commit}..${local_commit}")
    else
        commits=$(git rev-list \
            "$local_commit" --not --remotes)
    fi

    for commit in $commits
    do
        signature=$(git log -1 --format=%G? "$commit")
        case "$signature" in
            N|"")
                short=$(git rev-parse --short=12 "$commit")
                printf '%s\n' \
                    "pre-push: unsigned commit $short on $local_ref" >&2
                failed=1
                ;;
            B)
                short=$(git rev-parse --short=12 "$commit")
                printf '%s\n' \
                    "pre-push: bad signature on $short ($local_ref)" >&2
                failed=1
                ;;
        esac
    done
done

if [ "$failed" -ne 0 ]
then
    printf '%s\n' \
        "pre-push: sign reported commits before pushing." >&2
    exit 1
fi
